{
  "name": "finance-app",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint public server",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write public/*.js public/app.html public/*.css server/*.ts",
    "format:check": "prettier --check public/*.js public/app.html public/*.css server/*.ts",
    "prebuild": "node scripts/generate-release.mjs",
    "postbuild": "node scripts/protect-app-shell.mjs",
    "server": "node --experimental-transform-types --no-warnings --import ./backend/register.mjs backend/main.mjs",
    "test:server": "node --experimental-transform-types --no-warnings --import ./backend/register.mjs --test --test-concurrency=1 backend/test/server.test.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "globals": "^16.5.0",
    "postcss": "8.5.23",
    "prettier": "^3.9.10",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}

# Внешняя зашифрованная копия. Скопируйте в /etc/finance/backup.env (права 600, владелец root).
# Открытый ключ age (строка age1...). Закрытый ключ на сервер НЕ кладётся — он у владельца.
AGE_RECIPIENT=age1...
# S3 Selectel: адрес хранилища, регион, бакет и ключ сервисного пользователя
# с правом только на запись в этот бакет.
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=ogma-finance-backups
S3_PREFIX=finance
# vhost — https://ogma-finance-backups.s3.ru-1.storage.selcloud.ru/… (бакет создан с vHosted); path — для Path-Style.
S3_ADDRESSING=vhost
S3_ACCESS_KEY=
S3_SECRET_KEY=
